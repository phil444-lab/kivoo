generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PriceType {
  fixed
  negotiable
  rent
  auction
}

enum ItemCondition {
  new
  like_new
  good
  fair
  used
}

enum ItemStatus {
  active
  sold
  expired
  pending
}

enum MessageType {
  text
  image
  location
  contact
  item_share
}

enum NotificationType {
  message
  favorite
  price_drop
  new_item
  system
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

model User {
  id        String   @id @default(cuid())
  email     String   @db.VarChar(191) @unique
  password  String   @db.VarChar(191)
  name      String   @db.VarChar(100)
  phone     String   @db.VarChar(50) @unique
  photo     String?  @db.VarChar(191)
  location  Json?
  verified  Boolean  @default(false)
  rating    Float    @default(0)
  ratingCount Int    @default(0)
  joinedAt  DateTime @default(now())
  lastLogin DateTime?
  isActive  Boolean  @default(true)
  role      String   @default("user") @db.VarChar(20)
  socialProviders Json?
  preferences Json?

  items         Item[]
  favorites     Favorite[]
  reviewsGiven  Review[]  @relation("Reviewer")
  reviewsReceived Review[] @relation("Reviewed")
  conversationParticipants ConversationParticipant[]
  messages      Message[]
  notifications Notification[]
  pushTokens    PushToken[]
  reports       Report[]  @relation("Reporter")
  reportedIn    Report[] @relation("ReportedUser")
  reviewsModerated Report[] @relation("ReviewedBy")
  sessions      Session[]

  @@map("users")
}

model Session {
  id              String   @id @default(cuid())
  userId          String   @db.VarChar(25)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token           String   @db.Text
  refreshToken    String   @db.Text
  tokenHash       String   @db.VarChar(191) @unique
  refreshTokenHash String  @db.VarChar(191) @unique
  deviceInfo      String?  @db.VarChar(255)
  ipAddress       String?  @db.VarChar(45)
  expiresAt       DateTime
  refreshExpiresAt DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  isActive        Boolean  @default(true)

  @@index([userId])
  @@map("sessions")
}

model FeaturedOption {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(100)
  subtitle    String   @db.VarChar(100)
  icon        String   @db.VarChar(50)
  borderColor String   @db.VarChar(7)
  darkBg      String   @db.VarChar(7)
  lightBg     String   @db.VarChar(7)
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  items Item[]

  @@map("featured_options")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(50) @unique
  parentCategoryId String? @db.VarChar(25)
  parentCategory   Category?  @relation("Subcategories", fields: [parentCategoryId], references: [id])
  subcategories    Category[] @relation("Subcategories")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items      Item[]
  subItems   Item[]  @relation("Subcategory")

  @@map("categories")
}

model Item {
  id          String      @id @default(cuid())
  title       String      @db.VarChar(100)
  description String      @db.Text
  price       Float
  priceType   PriceType   @default(fixed)
  categoryId  String      @db.VarChar(25)
  category    Category    @relation(fields: [categoryId], references: [id])
  subcategoryId String?   @db.VarChar(25)
  subcategory Category?   @relation("Subcategory", fields: [subcategoryId], references: [id])
  sellerId    String      @db.VarChar(25)
  seller      User        @relation(fields: [sellerId], references: [id])
  location    Json?
  condition   ItemCondition @default(good)
  brand       String?     @db.VarChar(50)
  model       String?     @db.VarChar(50)
  year        Int?
  color       String?     @db.VarChar(50)
  images      Json?
  featured    Boolean     @default(false)
  featuredUntil DateTime?
  featureId   String?     @db.VarChar(25)
  feature     FeaturedOption? @relation(fields: [featureId], references: [id])
  departmentId String?    @db.VarChar(25)
  department  Department? @relation(fields: [departmentId], references: [id])
  cityId      String?     @db.VarChar(25)
  city        City?       @relation(fields: [cityId], references: [id])
  districtId  String?     @db.VarChar(25)
  district    District?   @relation(fields: [districtId], references: [id])
  status      ItemStatus  @default(active)
  views       Int         @default(0)
  likes       Int         @default(0)
  boostLevel  Int         @default(0)
  boostUntil  DateTime?
  tags        Json?
  specifications Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  expiresAt   DateTime

  favorites   Favorite[] @relation("ItemFavorites")
  conversations Conversation[] @relation("ItemConversations")
  reviews      Review[] @relation("ItemReviews")
  reports      Report[] @relation("ItemReports")

  @@index([categoryId, status])
  @@index([sellerId])
  @@index([price])
  @@index([createdAt])
  @@index([status])
  @@index([featured, boostLevel])
  @@index([featureId])
  @@index([departmentId])
  @@index([cityId])
  @@index([districtId])
  @@map("items")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(25)
  user      User     @relation(fields: [userId], references: [id])
  itemId    String   @db.VarChar(25)
  item      Item     @relation("ItemFavorites", fields: [itemId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model Conversation {
  id        String   @id @default(cuid())
  itemId    String?  @db.VarChar(25)
  item      Item?    @relation("ItemConversations", fields: [itemId], references: [id], onDelete: Cascade)
  lastMessageContent String? @db.VarChar(191)
  lastMessageSenderId String? @db.VarChar(25)
  lastMessageSentAt  DateTime?
  unreadCount Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  reviews      Review[]

  @@index([lastMessageSentAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String @db.VarChar(25)
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String @db.VarChar(25)
  user           User         @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String      @db.VarChar(25)
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String      @db.VarChar(25)
  sender         User         @relation(fields: [senderId], references: [id])
  content        String      @db.VarChar(191)
  type           MessageType  @default(text)
  attachments    Json?
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Review {
  id         String   @id @default(cuid())
  reviewerId String   @db.VarChar(25)
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewedId String   @db.VarChar(25)
  reviewed   User     @relation("Reviewed", fields: [reviewedId], references: [id])
  itemId     String?  @db.VarChar(25)
  item       Item?    @relation("ItemReviews", fields: [itemId], references: [id], onDelete: Cascade)
  conversationId String? @db.VarChar(25)
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  rating     Int
  comment    String?  @db.VarChar(191)
  createdAt  DateTime @default(now())

  @@unique([reviewerId, itemId])
  @@index([reviewedId, createdAt])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @db.VarChar(25)
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String           @db.VarChar(100)
  message   String           @db.VarChar(191)
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String   @db.VarChar(25)
  user      User     @relation(fields: [userId], references: [id])
  token     String   @db.VarChar(200) @unique
  platform  String   @default("android") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("push_tokens")
}

model Country {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  code      String   @db.VarChar(2) @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  departments Department[]

  @@map("countries")
}

model Department {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(100)
  countryId String   @db.VarChar(25)
  country   Country  @relation(fields: [countryId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  cities City[]
  items  Item[]

  @@index([countryId])
  @@map("departments")
}

model City {
  id           String     @id @default(cuid())
  name         String     @db.VarChar(100)
  departmentId String     @db.VarChar(25)
  department   Department @relation(fields: [departmentId], references: [id])
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())

  districts District[]
  items    Item[]

  @@index([departmentId])
  @@map("cities")
}

model District {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(100)
  cityId     String   @db.VarChar(25)
  city       City     @relation(fields: [cityId], references: [id])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  items Item[]

  @@index([cityId])
  @@map("districts")
}

model Report {
  id             String       @id @default(cuid())
  reporterId String   @db.VarChar(25)
  reporter   User     @relation("Reporter", fields: [reporterId], references: [id])
  reportedItemId String   @db.VarChar(25)
  reportedItem   Item     @relation("ItemReports", fields: [reportedItemId], references: [id], onDelete: Cascade)
  reportedUserId String   @db.VarChar(25)
  reportedUser   User     @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reason     String   @db.VarChar(100)
  description    String?  @db.VarChar(191)
  status     ReportStatus @default(pending)
  reviewedById   String?  @db.VarChar(25)
  reviewedBy     User?    @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())

  @@map("reports")
}
