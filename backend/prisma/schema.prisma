generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PriceType {
  fixed
  negotiable
  rent
  auction
}

enum ItemCondition {
  new
  like_new
  good
  fair
  used
}

enum ItemStatus {
  active
  sold
  expired
  pending
}

enum MessageType {
  text
  image
  location
  contact
}

enum NotificationType {
  message
  favorite
  price_drop
  new_item
  system
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  phone     String   @unique
  photo     String?
  location  Json?
  verified  Boolean  @default(false)
  rating    Float    @default(0)
  ratingCount Int    @default(0)
  joinedAt  DateTime @default(now())
  lastLogin DateTime?
  isActive  Boolean  @default(true)
  socialProviders Json?
  preferences Json?

  items         Item[]
  favorites     Favorite[]
  reviewsGiven  Review[]  @relation("Reviewer")
  reviewsReceived Review[] @relation("Reviewed")
  conversationParticipants ConversationParticipant[]
  messages      Message[]
  notifications Notification[]
  reports       Report[]  @relation("Reporter")
  reportedIn    Report[] @relation("ReportedUser")
  reviewsModerated Report[] @relation("ReviewedBy")

  @@map("users")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  icon      String   @default("📦")
  color     String   @default("#6366f1")
  parentCategoryId String?
  parentCategory   Category?  @relation("Subcategories", fields: [parentCategoryId], references: [id])
  subcategories    Category[] @relation("Subcategories")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items      Item[]
  subItems   Item[]  @relation("Subcategory")

  @@map("categories")
}

model Item {
  id          String      @id @default(cuid())
  title       String
  description String
  price       Float
  priceType   PriceType   @default(fixed)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  subcategoryId String?
  subcategory Category?   @relation("Subcategory", fields: [subcategoryId], references: [id])
  sellerId    String
  seller      User        @relation(fields: [sellerId], references: [id])
  location    Json?
  condition   ItemCondition @default(good)
  brand       String?
  model       String?
  year        Int?
  images      Json?
  featured    Boolean     @default(false)
  featuredUntil DateTime?
  status      ItemStatus  @default(active)
  views       Int         @default(0)
  likes       Int         @default(0)
  boostLevel  Int         @default(0)
  boostUntil  DateTime?
  tags        Json?
  specifications Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  expiresAt   DateTime

  favorites   Favorite[]
  conversations Conversation[]
  reviews      Review[]
  reports      Report[]

  @@index([categoryId, status])
  @@index([sellerId])
  @@index([price])
  @@index([createdAt])
  @@index([status])
  @@index([featured, boostLevel])
  @@map("items")
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  itemId    String
  item      Item     @relation(fields: [itemId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
  @@index([userId, createdAt])
  @@map("favorites")
}

model Conversation {
  id        String   @id @default(cuid())
  itemId    String?
  item      Item?    @relation(fields: [itemId], references: [id])
  lastMessageContent String?
  lastMessageSenderId String?
  lastMessageSentAt  DateTime?
  unreadCount Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
  reviews      Review[]

  @@index([lastMessageSentAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  userId         String
  user           User         @relation(fields: [userId], references: [id])

  @@id([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  content        String
  type           MessageType  @default(text)
  attachments    Json?
  read           Boolean      @default(false)
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Review {
  id         String   @id @default(cuid())
  reviewerId String
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewedId String
  reviewed   User     @relation("Reviewed", fields: [reviewedId], references: [id])
  itemId     String?
  item       Item?    @relation(fields: [itemId], references: [id])
  conversationId String?
  conversation Conversation? @relation(fields: [conversationId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@unique([reviewerId, itemId])
  @@index([reviewedId, createdAt])
  @@map("reviews")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
  @@map("notifications")
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reporter       User         @relation("Reporter", fields: [reporterId], references: [id])
  reportedItemId String
  reportedItem   Item         @relation(fields: [reportedItemId], references: [id])
  reportedUserId String
  reportedUser   User         @relation("ReportedUser", fields: [reportedUserId], references: [id])
  reason         String
  description    String?
  status         ReportStatus @default(pending)
  reviewedById   String?
  reviewedBy     User?        @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime     @default(now())

  @@map("reports")
}