# ============================================================
#  Déploiement Vercel : indique ici l'URL de votre backend en ligne
#  (ex. https://kivoo-backend.vercel.app)
#
#  En développement, le proxy de Vite (vite.config.ts) enverra les
#  requêtes /api vers cette adresse au lieu de localhost:5000.
# ============================================================
VITE_API_PROXY_TARGET=https://votre-backend.vercel.app

# Optionnel — base d'API directe (sans proxy) utilisée en mode preview/build.
# Si vide/vierge, le dashboard utilisera le proxy relatif '/api'.
# VITE_API_URL=https://votre-backend.vercel.app/api